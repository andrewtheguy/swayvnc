From 0dda6bb3092311c2129477127eb60ab62fda9568 Mon Sep 17 00:00:00 2001
From: Andrew Chen <andrew@jaanuu.com>
Date: Mon, 7 Sep 2026 13:16:10 -0700
Subject: [PATCH] Set the output's scale to the density a client declares, and
 answer every declaration

---
 include/output-management.h |  12 ++++
 src/main.c                  |  90 +++++++++++++++++++++++--
 src/output-management.c     | 131 ++++++++++++++++++++++++++++++++----
 3 files changed, 215 insertions(+), 18 deletions(-)

diff --git a/include/output-management.h b/include/output-management.h
index babdc58..beb9632 100644
--- a/include/output-management.h
+++ b/include/output-management.h
@@ -33,6 +33,18 @@ bool wlr_output_manager_get_head_scale(const char* name, double* scale);
 /* Called once per done event for every head whose scale changed. */
 void wlr_output_manager_set_head_scale_fn(wlr_output_manager_head_scale_fn fn,
 		void* userdata);
+typedef void (*wlr_output_manager_config_unchanged_fn)(bool applied,
+		void* userdata);
+/* Called when a scale configuration this module applied is over with no head
+ * scale change to follow it: the compositor rejected or cancelled it (applied
+ * false), or accepted it and left the head's scale as it was (applied true).
+ */
+void wlr_output_manager_set_config_unchanged_fn(
+		wlr_output_manager_config_unchanged_fn fn, void* userdata);
 bool wlr_output_manager_resize_output(struct output* output,
 	uint16_t width, uint16_t height);
+/* Set the head's scale, keeping its mode; the compositor reports the result
+ * through the head scale callback, or the unchanged callback.
+ */
+bool wlr_output_manager_set_output_scale(struct output* output, double scale);
 void wlr_output_manager_destroy(void);
diff --git a/src/main.c b/src/main.c
index 50c9437..76bfa24 100644
--- a/src/main.c
+++ b/src/main.c
@@ -160,8 +160,12 @@ struct wayvnc_client {
 /* A private RFB extension carrying pixel density, which standard RFB has no
  * word for. The client lists the pseudo-encoding in SetEncodings; the server
  * answers with an OutputScale message and repeats it whenever the captured
- * output's scale or size changes. The client may declare its own density with
- * a ClientDensity message. Scales are 16.16 unsigned fixed point.
+ * output's scale or size changes. The client may declare the density it wants
+ * the output drawn at with a ClientDensity message: the server sets the
+ * output's scale to it where it may, and every declaration is answered with
+ * an OutputScale: after the change, or in its place when the compositor
+ * refuses it or applies it with the scale unchanged. Scales are 16.16 unsigned
+ * fixed point.
  */
 #define SWAYVNC_ENCODING_DENSITY 0x53564e43 /* 'SVNC' */
 #define SWAYVNC_MSG_DENSITY 0xe0
@@ -177,6 +181,7 @@ static void on_nvnc_client_new(struct nvnc_client* client);
 static void broadcast_output_scale(struct wayvnc* self);
 static void on_head_scale_change(const char* name, double scale,
 		void* userdata);
+static void on_output_config_unchanged(bool applied, void* userdata);
 static void on_client_encodings(struct nvnc_client* nvnc_client,
 		const int32_t* encodings, size_t n_encodings);
 static int on_client_extension_message(struct nvnc_client* nvnc_client,
@@ -312,6 +317,8 @@ static void registry_add(void* data, struct wl_registry* registry,
 			wl_registry_bind(registry, id,
 				&zwlr_output_manager_v1_interface, 1);
 		wlr_output_manager_setup(wlr_output_manager);
+		wlr_output_manager_set_config_unchanged_fn(
+				on_output_config_unchanged, self);
 		wlr_output_manager_set_head_scale_fn(on_head_scale_change,
 				self);
 		return;
@@ -1155,6 +1162,57 @@ static void on_client_encodings(struct nvnc_client* nvnc_client,
 	send_output_scale(client);
 }
 
+static bool scales_equal(double a, double b)
+{
+	double diff = a - b;
+	return diff < 0.005 && diff > -0.005;
+}
+
+/* Set the captured output's scale to the density the client declared, the way
+ * a client's SetDesktopSize sets its mode: only for the client that owns the
+ * layout, and only where resizing is allowed at all. The compositor's head
+ * change then reports the new scale to every client. When nothing is to be
+ * changed, or nothing can be, the client is answered with the current scale
+ * at once, so a declaration is never left without a report.
+ */
+static void follow_client_density(struct wayvnc_client* client)
+{
+	struct wayvnc* self = client->server;
+	struct output* output = self->selected_output;
+	if (!output)
+		return;
+
+	double density = client->declared_density;
+	double current = output_scale(output);
+	if (scales_equal(current, density)) {
+		send_output_scale(client);
+		return;
+	}
+
+	if (!self->enable_resizing) {
+		nvnc_log(NVNC_LOG_INFO,
+			"Not following client %u's density %.2f: resizing is disabled",
+			client->id, density);
+		send_output_scale(client);
+		return;
+	}
+
+	if (self->master_layout_client && self->master_layout_client != client) {
+		nvnc_log(NVNC_LOG_INFO,
+			"Not following client %u's density %.2f: another client owns the layout",
+			client->id, density);
+		send_output_scale(client);
+		return;
+	}
+
+	self->master_layout_client = client;
+	nvnc_log(NVNC_LOG_INFO,
+		"Following client %u's density: setting output %s scale from %.2f to %.2f",
+		client->id, output->name, current, density);
+	if (!wlr_output_manager_set_output_scale(output, density))
+		send_output_scale(client);
+}
+
 static int on_client_extension_message(struct nvnc_client* nvnc_client,
 		const uint8_t* msg, size_t len)
 {
@@ -1168,14 +1226,38 @@ static int on_client_extension_message(struct nvnc_client* nvnc_client,
 		(uint32_t)msg[6] << 8 | msg[7];
 	double density = fixed / 65536.0;
 
-	if (client) {
-		client->declared_density = density;
+	if (client && client->wants_output_scale) {
 		nvnc_log(NVNC_LOG_INFO, "Client %u declares a display density of %.2f",
 				client->id, density);
+		if (density < 0.5 || density > 8.0) {
+			nvnc_log(NVNC_LOG_WARNING,
+				"Ignoring client %u's density %.2f: out of range",
+				client->id, density);
+			send_output_scale(client);
+		} else {
+			client->declared_density = density;
+			follow_client_density(client);
+		}
 	}
 	return SWAYVNC_CLIENT_DENSITY_LEN;
 }
 
+/* A declared density the compositor did not turn into a head scale change:
+ * rejected, or accepted with the scale left as it was. Either way the
+ * declaration is owed its answer, so the scale is reported as it is.
+ */
+static void on_output_config_unchanged(bool applied, void* userdata)
+{
+	struct wayvnc* self = userdata;
+	if (applied)
+		nvnc_log(NVNC_LOG_INFO,
+			"The compositor applied the output configuration without changing the scale; reporting it as it is");
+	else
+		nvnc_log(NVNC_LOG_WARNING,
+			"The compositor rejected the output configuration; reporting the scale as it is");
+	broadcast_output_scale(self);
+}
+
 static void on_output_scale_change(struct output* output)
 {
 	struct wayvnc* self = output->userdata;
diff --git a/src/output-management.c b/src/output-management.c
index 0bdfb73..420c20d 100644
--- a/src/output-management.c
+++ b/src/output-management.c
@@ -38,6 +38,45 @@ static uint32_t last_config_serial;
 static struct zwlr_output_manager_v1* wlr_output_manager;
 static wlr_output_manager_head_scale_fn head_scale_fn;
 static void* head_scale_userdata;
+static wlr_output_manager_config_unchanged_fn config_unchanged_fn;
+static void* config_unchanged_userdata;
+/* One scale configuration at a time is tracked from its apply until the
+ * compositor has settled it, so that one which is accepted without a head
+ * scale changing can still be reported. succeeded says nothing about whether
+ * a head changes: the protocol has the changes and their done follow it when
+ * there are any, and sway sends them first when a commit runs on the spot. So
+ * a succeeded with no scale change seen yet is followed by one round trip,
+ * after which whatever the compositor was going to send has arrived.
+ */
+static bool scale_config_pending;
+static bool scale_changed_since_apply;
+static struct wl_callback* scale_settle_callback;
+
+static void report_scale_config_unchanged(bool applied)
+{
+	scale_config_pending = false;
+	if (config_unchanged_fn)
+		config_unchanged_fn(applied, config_unchanged_userdata);
+}
+
+static void scale_settle_done(void* data, struct wl_callback* callback,
+		uint32_t serial)
+{
+	wl_callback_destroy(callback);
+	scale_settle_callback = NULL;
+	if (!scale_config_pending)
+		return;
+	if (scale_changed_since_apply) {
+		scale_config_pending = false;
+		return;
+	}
+	nvnc_trace("config request succeeded without a scale change");
+	report_scale_config_unchanged(true);
+}
+
+static const struct wl_callback_listener scale_settle_listener = {
+	.done = scale_settle_done,
+};
 
 /* single head properties */
 static void output_head_name(void* data,
@@ -143,6 +182,21 @@ static void output_manager_config_succeeded(void* data,
 {
 	nvnc_trace("config request succeeded");
 	zwlr_output_configuration_v1_destroy(config);
+	if (!data || !scale_config_pending || scale_settle_callback)
+		return;
+	if (scale_changed_since_apply) {
+		scale_config_pending = false;
+		return;
+	}
+	struct wl_display* display = wl_proxy_get_display(
+			(struct wl_proxy*)wlr_output_manager);
+	scale_settle_callback = wl_display_sync(display);
+	if (!scale_settle_callback) {
+		report_scale_config_unchanged(true);
+		return;
+	}
+	wl_callback_add_listener(scale_settle_callback,
+			&scale_settle_listener, NULL);
 }
 
 static void output_manager_config_failed(void* data,
@@ -150,6 +204,8 @@ static void output_manager_config_failed(void* data,
 {
 	nvnc_trace("config request failed");
 	zwlr_output_configuration_v1_destroy(config);
+	if (data && scale_config_pending)
+		report_scale_config_unchanged(false);
 }
 
 static void output_manager_config_cancelled(void* data,
@@ -157,6 +213,8 @@ static void output_manager_config_cancelled(void* data,
 {
 	nvnc_trace("config request cancelled");
 	zwlr_output_configuration_v1_destroy(config);
+	if (data && scale_config_pending)
+		report_scale_config_unchanged(false);
 }
 
 struct zwlr_output_configuration_v1_listener wlr_output_config_listener = {
@@ -178,6 +236,8 @@ static void output_manager_done(void* data,
 		if (!head->is_scale_changed)
 			continue;
 		head->is_scale_changed = false;
+		if (scale_config_pending)
+			scale_changed_since_apply = true;
 		if (head_scale_fn && head->name)
 			head_scale_fn(head->name, head->scale,
 					head_scale_userdata);
@@ -240,6 +300,13 @@ void wlr_output_manager_set_head_scale_fn(wlr_output_manager_head_scale_fn fn,
 	head_scale_userdata = userdata;
 }
 
+void wlr_output_manager_set_config_unchanged_fn(
+		wlr_output_manager_config_unchanged_fn fn, void* userdata)
+{
+	config_unchanged_fn = fn;
+	config_unchanged_userdata = userdata;
+}
+
 void wlr_output_manager_setup(struct zwlr_output_manager_v1* output_manager)
 {
 	if (wlr_output_manager)
@@ -268,20 +335,29 @@ void wlr_output_manager_destroy(void)
 	wlr_output_manager = NULL;
 
 	last_config_serial = 0;
+	if (scale_settle_callback) {
+		wl_callback_destroy(scale_settle_callback);
+		scale_settle_callback = NULL;
+	}
+	scale_config_pending = false;
 }
 
-bool wlr_output_manager_resize_output(struct output* output,
-		uint16_t width, uint16_t height)
+/* Apply a configuration that changes the named output's mode, when width and
+ * height are nonzero, and its scale, when scale is nonzero, and leaves every
+ * other property of every head as the compositor has it.
+ */
+static bool configure_output(struct output* output, uint16_t width,
+		uint16_t height, double scale)
 {
 	if (!wlr_output_manager) {
 		nvnc_log(NVNC_LOG_INFO,
-			"output-management protocol not available, not resizing output");
+			"output-management protocol not available, not reconfiguring output");
 		return false;
 	}
 
 	if (!output->is_headless) {
 		nvnc_log(NVNC_LOG_INFO,
-			"not resizing output %s: not a headless one",
+			"not reconfiguring output %s: not a headless one",
 			output->name);
 		return false;
 	}
@@ -294,8 +370,16 @@ bool wlr_output_manager_resize_output(struct output* output,
 
 	config = zwlr_output_manager_v1_create_configuration(
 		wlr_output_manager, last_config_serial);
+	/* The listener's data marks a configuration that sets a scale: the one
+	 * kind whose settlement is tracked and reported.
+	 */
 	zwlr_output_configuration_v1_add_listener(config,
-			&wlr_output_config_listener, NULL);
+			&wlr_output_config_listener,
+			scale > 0 ? output : NULL);
+	if (scale > 0) {
+		scale_config_pending = true;
+		scale_changed_since_apply = false;
+	}
 
 	struct output_manager_head* head;
 	wl_list_for_each(head, &heads, link) {
@@ -310,15 +394,23 @@ bool wlr_output_manager_resize_output(struct output* output,
 			config, head->head);
 		if (head->name && strcmp(head->name, output->name) == 0) {
 			nvnc_trace("reconfiguring output %s", head->name);
-			zwlr_output_configuration_head_v1_set_custom_mode(
-				config_head, width, height, refresh_rate);
-
-			/* It doesn't make any sense to have rotation on a
-			 * headless display, so we set the transform here to be
-			 * sure.
-			 */
-			zwlr_output_configuration_head_v1_set_transform(
-					config_head, WL_OUTPUT_TRANSFORM_NORMAL);
+			if (width && height) {
+				zwlr_output_configuration_head_v1_set_custom_mode(
+					config_head, width, height,
+					refresh_rate);
+
+				/* It doesn't make any sense to have rotation on
+				 * a headless display, so we set the transform
+				 * here to be sure.
+				 */
+				zwlr_output_configuration_head_v1_set_transform(
+					config_head,
+					WL_OUTPUT_TRANSFORM_NORMAL);
+			}
+			if (scale > 0)
+				zwlr_output_configuration_head_v1_set_scale(
+					config_head,
+					wl_fixed_from_double(scale));
 		}
 
 		zwlr_output_configuration_head_v1_destroy(config_head);
@@ -328,3 +420,14 @@ bool wlr_output_manager_resize_output(struct output* output,
 	zwlr_output_configuration_v1_apply(config);
 	return true;
 }
+
+bool wlr_output_manager_resize_output(struct output* output,
+		uint16_t width, uint16_t height)
+{
+	return configure_output(output, width, height, 0);
+}
+
+bool wlr_output_manager_set_output_scale(struct output* output, double scale)
+{
+	return configure_output(output, 0, 0, scale);
+}
-- 
2.51.1

